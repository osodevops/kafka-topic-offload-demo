# Copy to .env (make does this for you). Every image is pinned; tags confirmed 2026-09-15.

CP_SERVER_IMAGE=confluentinc/cp-server:8.3.1
CP_KAFKA_IMAGE=confluentinc/cp-kafka:8.3.1
CP_SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:8.3.1
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
AZURITE_IMAGE=mcr.microsoft.com/azure-storage/azurite:3.37.0

# The published osodevops/kafka-backup:v0.22.0 image is amd64 only. On arm64 hosts
# `make build-kafka-backup` builds the v0.22.0 tag natively so throughput numbers are
# not distorted by emulation. On amd64 hosts set this to osodevops/kafka-backup:v0.22.0.
KAFKA_BACKUP_IMAGE=kafka-backup:0.22.0-arm64
KAFKA_BACKUP_SRC=../kafka-backup
KAFKA_BACKUP_TAG=v0.22.0

# Dataset
SCALE=smoke                     # smoke (1 GiB) | 10g | 100g
SEED=20260915
TOPIC=device-telemetry
PARTITIONS=6
LATE_MAX_HOURS=72

# Retention prune and audit window
RETENTION_AFTER_PRUNE_MS=2592000000   # 30 days
AUDIT_MONTHS_AGO=9
AUDIT_DAYS=30

# Object storage (local only; never reuse these credentials)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=kafka-backups
S3_SEALED_BUCKET=kafka-backups-sealed
SEAL_MODE=GOVERNANCE
SEAL_RETENTION=30d

# The prune gate blocks while any consumer group with committed offsets would fall below
# the new log start, unless that group is named here. The demo group telemetry-analytics is
# deliberately 60 days behind; negative test 4 shows the gate blocking without this.
ACK_CONSUMER_IMPACT=telemetry-analytics

# Set to 1 to skip the second backup at 4x larger segments (request count comparison).
SKIP_SEGMENT_COMPARISON=0

# Extrapolation in phase 70: logical topic sizes in TB (10^12 bytes), and the Confluent Cloud
# Dedicated cluster size in CKUs (2 is the multi-zone minimum).
EXTRAPOLATE_SIZES_TB=1,10,50
CONFLUENT_CKU=2

# Phase 45: how far back the partial archive starts, and how long a range is restored as at
# that instant.
ARCHIVE_SINCE_DAYS=90
ASAT_RANGE_DAYS=30
