# Time window restore of one topic into a new topic on the target cluster, read from the
# sealed copy. Offsets on the target are new; every record keeps the x-original-offset and
# x-original-timestamp headers written at backup time.
mode: restore
backup_id: "${BACKUP_ID}"

target:
  bootstrap_servers:
    - target-kafka:29092
  topics:
    include:
      - "${TOPIC}"

storage:
  backend: s3
  bucket: "${BACKUP_BUCKET}"
  region: us-east-1
  endpoint: "http://minio:9000"
  path_style: true
  allow_http: true
  prefix: "${S3_PREFIX}"

restore:
  # Padded by the maximum lateness on both sides. 0.22.0 selects segments by their first
  # and last record timestamps, not min and max, so late records near the window
  # edges are skipped without the pad.
  time_window_start: ${WINDOW_START}
  time_window_end: ${WINDOW_END}
  topic_mapping:
    "${TOPIC}": "${TARGET_TOPIC}"
  create_topics: true
  default_replication_factor: 1
  restore_topic_configs: true
  # Never append to, or silently reconfigure, a topic that already exists.
  existing_topic_config_policy: fail
  # The backup captured retention.ms=-1, but a scratch topic must never age data out
  # whatever the backup carries.
  topic_config_overrides:
    "${TARGET_TOPIC}":
      retention.ms: "-1"
      retention.bytes: "-1"
  consumer_group_strategy: skip
  # 0.22.0 does not split produce batches by size. 250 records of about 2 KB stay
  # under the target's message.max.bytes; the phase checks this before restoring.
  produce_batch_size: 250
  produce_acks: -1
  max_concurrent_partitions: 6
